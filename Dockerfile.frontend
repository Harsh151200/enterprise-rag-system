FROM python:3.11-slim

WORKDIR /app

# Install UI dependencies
COPY requirements-frontend.txt .
RUN pip install --no-cache-dir -r requirements-frontend.txt

# Copy frontend code
COPY app_ui.py .

EXPOSE 8501

# Dynamic PORT handling for Streamlit (defaults to 8501 locally, adapts if hosted on serverless platforms)
CMD ["sh", "-c", "streamlit run app_ui.py --server.port ${PORT:-8501} --server.address 0.0.0.0"]